# Konfigurasi NON-secret (dibaca ta-up.ps1 untuk Go dan FastAPI). Secret ada di .env.
# Konfigurasi ini sekaligus mengunci kondisi pengukuran: catat nilainya di bab metodologi.
CACHE_MODE=hybrid
AI_MODE=http
AI_URL=http://127.0.0.1:8000/analyze
LISTEN_HOST=127.0.0.1
PORT=8080
REDIS_ADDR=127.0.0.1:6379
# ---- Parameter penelitian (Tabel parameter Bab 3). Nilai final ditentukan dari pilot study. ----
# TTL_base: TTL statis (static_ttl) sekaligus dasar TTL dinamis.
TTL_BASE_SECONDS=3600
# dynamic_ttl / hybrid: TTL = clamp(TTL_base / (1 + k * sigma / sigma_ref), TTL_min, TTL_max)
# sigma = stddev log return 14 candle 1h; sigma_ref per instrument dari 1 tahun data (mean atau pNN)
DYNAMIC_TTL_K=1
DYNAMIC_TTL_MIN_SECONDS=300
DYNAMIC_TTL_MAX_SECONDS=3600
SIGMA_REF_STAT=mean
# event_only / hybrid: buang cache kalau drift harga >= theta (%) atau kondisi indikator S berubah
# theta yang diuji: 1, 2, 5, 10. Ganti lewat: .\ta-up.ps1 restart hybrid http 2
INVALIDATION_THRESHOLD_PCT=2
# Pemeriksaan ketiga hybrid invalidation (Gambar 3.4): S = zona RSI, harga vs EMA20, tanda histogram MACD
INVALIDATE_ON_STATE=on
# event_only tidak punya kedaluwarsa waktu; ini hanya batas pengaman di Redis
EVENT_MAX_TTL_SECONDS=86400
# Pre-generation (Lapis 1): top-N instrument populer di-generate tiap interval Delta.
# Hanya untuk mode dengan cache. Ganti lewat: .\ta-up.ps1 restart hybrid http 2 on
PREGEN=on
PREGEN_INTERVAL_SECONDS=900
PREGEN_TOP_N=3
PREGEN_WINDOW_HOURS=24
PREGEN_MIN_ACCESS=1

# Price feed WebSocket Binance (aggTrade) untuk event invalidation, prompt, dan freshness harga
PRICE_FEED=on
BINANCE_WS_URL=wss://data-stream.binance.vision
# Futures: aggTrade/kline/miniTicker hanya ada di path /market (path lama tersambung tapi tanpa data)
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market
PRICE_MAX_AGE_SECONDS=30
# Simbol sepi (mis. tembaga, platinum) tetap memakai harga transaksi terakhir selama koneksi market sehat,
# sampai tidak bertransaksi selama ini; setelah itu harga dari DB (candle 1h).
PRICE_IDLE_MAX_SECONDS=900
# Watcher memeriksa ulang tiap N detik: candle baru tutup (S berubah) dan saham (tanpa tick)
WATCHER_REFRESH_SECONDS=30
# Rate limiting per IP untuk /api/* (k6 dan pilot dikecualikan); 0 = mati
RATE_LIMIT_RPS=20
# Timeout HTTP Go -> AI service; harus > HERMES_QUEUE_TIMEOUT + HERMES_TIMEOUT
AI_TIMEOUT_SECONDS=330
# Stub (AI_MODE=stub, lab): pilot = latency/token/gagal format per metode dari pilot AI 5 Nov (backend/ai.go
# stubProfiles); angka mis. 300 = delay tetap untuk uji UI cepat.
STUB_DELAY_MS=pilot

# Hermes. HERMES_BIN boleh path penuh, mis. C:\Users\NAMA\AppData\Local\hermes\hermes.exe (cek: where.exe hermes)
HERMES_BIN=hermes
# context_engine = toolset tanpa tool: model tidak bisa memanggil clarify (uji 4 Nov: model kecil
# memanggil clarify berulang sampai ratusan ribu token). Skill tetap dimuat lewat system prompt.
HERMES_TOOLSETS=context_engine
# Tiga metode analisis = Hermes project skills di .hermes/skills/trading-analysis.
# preload: hermes -s <skill> (sekali per mesin: hermes skills trust <folder repo>); inline: isi SKILL.md masuk prompt
HERMES_SKILL_MODE=preload
# Batas iterasi tool per analisis (hermes chat --max-turns), pengaman kalau toolset diganti
HERMES_MAX_TURNS=2
HERMES_REASONING=none
HERMES_MAX_CONCURRENCY=1
HERMES_TIMEOUT=120
HERMES_QUEUE_TIMEOUT=180
# Kosong = pakai default Hermes (config.yaml). Isi saat model dikunci.
HERMES_MODEL=
HERMES_PROVIDER=

# Versi prompt: naikkan setiap teks prompt di app.py ATAU isi skill di .hermes/skills diubah.
# hermes-v5 = tiga metode (debate, mtf, grounded) + data multi-timeframe dan fundamental.
PROMPT_VERSION=hermes-v5

# Harga resmi model (USD per juta token) untuk biaya setara. Isi saat model dikunci; 0 = pakai angka dari Hermes.
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
PRICE_CACHE_READ_PER_M=0
# AI berlangganan (mis. Codex lewat ChatGPT): biaya per token 0, biaya komputasi = konsumsi kuota.
# Snapshot kuota: ta-up quota (cron tiap 10 menit saat eksperimen). Provider default = HERMES_PROVIDER.
QUOTA_PROVIDER=
# Biaya langganan per bulan untuk amortisasi (0 / kosong = tidak dihitung), mata uang ISO 4217
SUBSCRIPTION_FEE_MONTHLY=0
SUBSCRIPTION_CURRENCY=USD

# UI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Kurs hanya untuk mengurutkan nilai transaksi saham (IDR) vs kripto (USD) di Home
USDIDR_RATE=16000
