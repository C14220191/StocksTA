# Konfigurasi NON-secret (dibaca ta-up.ps1 untuk Go dan FastAPI). Secret ada di .env.
# Konfigurasi ini sekaligus mengunci kondisi pengukuran: catat nilainya di bab metodologi.
CACHE_MODE=no_cache
AI_MODE=http
AI_URL=http://127.0.0.1:8000/analyze
LISTEN_HOST=127.0.0.1
PORT=8080
REDIS_ADDR=127.0.0.1:6379
STATIC_TTL_SECONDS=3600
# dynamic_ttl / hybrid: TTL = TTL_max - clamp(sigma/sigma_ref, 0, 1) * (TTL_max - TTL_min)
# sigma_ref = persentil SIGMA_REF_PERCENTILE dari realized volatility 14 candle 1h selama 1 tahun
DYNAMIC_TTL_MIN_SECONDS=300
DYNAMIC_TTL_MAX_SECONDS=3600
SIGMA_REF_PERCENTILE=90
# event_only / hybrid: buang cache kalau |harga sekarang / price_at_generation - 1| >= ambang (%)
# Ambang yang diuji: 1, 2, 5, 10. Ganti lewat: .\ta-up.ps1 restart hybrid http 2
INVALIDATION_THRESHOLD_PCT=2
# event_only tidak punya kedaluwarsa waktu; ini hanya batas pengaman di Redis
EVENT_MAX_TTL_SECONDS=86400
# Price feed kripto (polling ticker Binance) untuk event invalidation, prompt, dan freshness harga
PRICE_FEED=on
PRICE_POLL_SECONDS=2
PRICE_MAX_AGE_SECONDS=30
# Timeout HTTP Go -> AI service; harus > HERMES_QUEUE_TIMEOUT + HERMES_TIMEOUT
AI_TIMEOUT_SECONDS=330
STUB_DELAY_MS=300

# Hermes. HERMES_BIN boleh path penuh, mis. C:\Users\NAMA\AppData\Local\hermes\hermes.exe (cek: where.exe hermes)
HERMES_BIN=hermes
HERMES_TOOLSETS=clarify
HERMES_REASONING=none
HERMES_MAX_CONCURRENCY=1
HERMES_TIMEOUT=120
HERMES_QUEUE_TIMEOUT=180
# Kosong = pakai default Hermes (config.yaml). Isi saat model dikunci.
HERMES_MODEL=
HERMES_PROVIDER=

# Versi prompt: naikkan setiap teks prompt di app.py diubah.
PROMPT_VERSION=hermes-v3

# Harga resmi model (USD per juta token) untuk biaya setara. Isi saat model dikunci; 0 = pakai angka dari Hermes.
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
PRICE_CACHE_READ_PER_M=0

# UI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Kurs hanya untuk mengurutkan nilai transaksi saham (IDR) vs kripto (USD) di Home
USDIDR_RATE=16000
