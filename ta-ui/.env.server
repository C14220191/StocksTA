# Dipakai oleh `npm run dev:server`: UI di PC memakai backend di server lewat tunnel SSH.
# Jalankan tunnel dulu di terminal terpisah (biarkan terbuka):
#   ssh -N -L 18080:127.0.0.1:8080 ubuntu@<IP-SERVER>
# Port lokal 18080 (bukan 8080) supaya tidak tertukar dengan backend lokal di PC.
# Tidak berisi rahasia; aman di-commit.
VITE_API_URL=http://127.0.0.1:18080
